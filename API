name: Automated API Testing

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  run-api-tests:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 18

      - name: Install Newman
        run: |
          npm install -g newman

      - name: Run Newman Test with CSV Data
        run: |
          newman run Collection.json \
            -e Environment.json \
            -d users.csv \
            --env-var "token=${{ secrets.GOREST_TOKEN }}"
